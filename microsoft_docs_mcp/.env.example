# =====================================================================================================================
# microsoft-docs (microsoft_docs_mcp) - configuracao do administrador
# RAG de documentacao OFICIAL Microsoft: unico componente com acesso a internet. NAO tem credenciais nem acessa servidores.
# Este arquivo so ajusta cache, modo offline e (opcional) o modo http. Lido quando o MCP inicia: depois de alterar,
# REINICIE o Claude Code. O arquivo e procurado na PASTA DE TRABALHO do MCP (o registro usa uv --directory
# C:\mcp\microsoft_docs_mcp) ou no caminho da variavel de SISTEMA MS_DOCS_ENV_FILE (nao vale dentro do .env).
# Variavel ja definida no ambiente do sistema VENCE a deste arquivo. Linhas com # estao DESLIGADAS: tire o # para ativar.
# Os valores ativos abaixo ja sao os PADROES do codigo. Nunca versione o .env.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# 1. CONSULTA EXTERNA E CACHE (regra do projeto: sair para a internet o MINIMO possivel)
# ---------------------------------------------------------------------------------------------------------------------
# true = NUNCA sai para a internet: se o cache nao responde, devolve needs_network. Padrao false.
# (cada chamada tambem pode pedir cache_only=true; a resposta informa em 'network' o que foi pedido a rede)
MS_DOCS_OFFLINE=false
# Pasta do cache em disco (paginas e buscas, no maximo 400 arquivos de cada tipo).
# Padrao: %LOCALAPPDATA%\microsoft-docs-mcp (ou ~/.cache/microsoft-docs-mcp fora do Windows).
# MS_DOCS_CACHE_DIR=D:\Cache\microsoft-docs-mcp
# Validade do cache, em DIAS: paginas lidas (padrao 7) e resultados de busca (padrao 1). Inteiros.
MS_DOCS_PAGE_TTL_DAYS=7
MS_DOCS_SEARCH_TTL_DAYS=1

# ---------------------------------------------------------------------------------------------------------------------
# 2. COMO O MCP E OFERECIDO (so mexa para publicar o MCP em outro servidor)
# ---------------------------------------------------------------------------------------------------------------------
# stdio (padrao) = Claude Code/Desktop na mesma maquina | http = deploy remoto (exige MCP_AUTH_TOKEN)
MCP_TRANSPORT=stdio
# Endereco e porta de escuta no modo http (127.0.0.1 = so a propria maquina). Porta padrao do RAG: 8001
# (o coletor windows-ops usa 8000; nao repita a porta se os dois rodarem no mesmo servidor).
MCP_HOST=127.0.0.1
MCP_PORT=8001
# OBRIGATORIO no modo http: token Bearer com 32 ou mais caracteres. Gere com:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=
# true permite o modo http SEM token, mas so em loopback (127.0.0.1) e apenas para testes locais.
MCP_ALLOW_INSECURE_LOOPBACK=false
