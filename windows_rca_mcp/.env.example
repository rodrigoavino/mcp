# =====================================================================================================================
# windows-ops (windows_rca_mcp) - configuracao do administrador
# Este arquivo e lido quando o MCP inicia: depois de alterar, REINICIE o Claude Code (ou o servico do MCP).
# NUNCA versione o .env (tem a credencial). O modelo sem segredos e o .env.example.
# Linhas iniciadas por # estao DESLIGADAS: tire o # para ativar. Os valores ativos abaixo ja sao os PADROES do codigo,
# exceto onde indicado. Para apontar outro arquivo .env use a variavel de SISTEMA WINRM_ENV_FILE (nao vale dentro do .env).
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# 1. CREDENCIAL E CONEXAO WINRM
# ---------------------------------------------------------------------------------------------------------------------
# Conta usada para conectar nos servidores (somente leitura na pratica). Formato: DOMINIO\conta, conta@dominio ou, para
# conta local do servidor, o nome da conta. A MESMA conta e usada em todos os servidores: ela precisa conseguir autenticar
# em cada um (em varios dominios, conta de dominio com relacao de confianca).
WINRM_USER=DOMINIO\svc_mcp_ops
# Senha da conta acima. Se tiver # ou espacos, coloque entre aspas simples.
WINRM_PASSWORD=
# Autenticacao do WinRM: ntlm (padrao) | kerberos | basic | credssp (conforme suportado pelo pywinrm instalado)
WINRM_TRANSPORT=ntlm
# true = HTTPS (porta 5986, recomendado) | false = HTTP (porta 5985, sem criptografia de transporte)
WINRM_SSL=true
# Porta do WinRM. Padrao: 5986 com SSL e 5985 sem SSL. So defina para porta nao padrao.
# WINRM_PORT=5986
# Certificado do servidor: validate = exige certificado confiavel e com o nome do servidor (PADRAO, producao)
#                          ignore   = nao valida (SOMENTE laboratorio / certificado autoassinado)
WINRM_VALIDATE_CERT=validate

# ---------------------------------------------------------------------------------------------------------------------
# 2. QUAIS SERVIDORES O MCP PODE ACESSAR
# ---------------------------------------------------------------------------------------------------------------------
# Lista de servidores permitidos, separados por virgula, com curingas. Exemplos: *.dominio.local,srv01,10.10.*
#   *  = qualquer servidor (nome ou IP) que consiga autenticar. Obrigatoria: vazia = nenhum servidor (fail-closed).
# Atencao: com * a credencial pode ser enviada a qualquer host pedido; use com WINRM_VALIDATE_CERT=validate em producao.
WINRM_ALLOWED_HOSTS=*.dominio.local
# Trava OPCIONAL: true recusa servidor que resolve para endereco PUBLICO (aceita privado, loopback, link-local, CGNAT).
# Padrao false: nada e bloqueado, o MCP conecta por nome ou IP.
WINRM_INTERNAL_ONLY=false

# ---------------------------------------------------------------------------------------------------------------------
# 3. VALIDACAO AUTOMATICA DA CONEXAO (primeiro passo de toda tool com host)
# ---------------------------------------------------------------------------------------------------------------------
# on (padrao) = antes de cada tool testa DNS, TCP, TLS e /wsman (sem credencial) e avisa na hora a camada do problema.
# off desliga. A tool check_winrm continua disponivel e valida tambem a autenticacao.
MCP_PREFLIGHT=on
# Segundos de espera por tentativa de conexao na sonda (1 a 30). Padrao 5 (a sonda tenta 2 vezes em caso de timeout).
MCP_PREFLIGHT_TIMEOUT=5
# Segundos em que o resultado da sonda fica em cache: quando deu OK (padrao 60) e quando falhou (padrao 10). 0 = sem cache.
MCP_PREFLIGHT_TTL_OK=60
MCP_PREFLIGHT_TTL_FAIL=10

# ---------------------------------------------------------------------------------------------------------------------
# 4. ARQUIVOS E LOGS (leitura somente)
# ---------------------------------------------------------------------------------------------------------------------
# Pastas de log ADICIONAIS que get_log_tail, search_log e list_log_files podem ler (separadas por ;). So .log e .txt.
# Padrao: Windows\Logs, System32\LogFiles, Panther, INF, debug e inetpub\logs. Exemplo: D:\AppLogs;D:\Outros
# WINRM_LOG_DIRS_EXTRA=D:\AppLogs
# Pastas que read_file, list_directory, find_files, file_info e compare_files NUNCA leem (separadas por ;), alem dos
# bloqueios padrao (hives do registro, NTDS, DPAPI, chaves SSH, certificados/chaves, dumps). Exemplo: D:\Segredos
# WINRM_FILE_DENY_EXTRA=D:\Segredos
# Arquivo do inventario do run_on_hosts/list_hosts (hosts.json: so nomes e tags, sem credenciais). Padrao: hosts.json na
# pasta do projeto. Opcional: a lista de servidores pode vir do CMDB e ser passada por nome ou IP em 'hosts'.
# WINRM_HOSTS_FILE=C:\mcp\windows_rca_mcp\hosts.json

# ---------------------------------------------------------------------------------------------------------------------
# 5. AUDITORIA E HORARIO DAS RESPOSTAS
# ---------------------------------------------------------------------------------------------------------------------
# Registro de cada chamada (tool, host, argumentos, ok/erro, duracao; NUNCA o conteudo devolvido nem segredos). off desliga.
MCP_AUDIT=on
# Arquivo do registro. Padrao: logs\audit.jsonl na pasta do projeto (rotacao de 5 MB x 5 arquivos).
# MCP_AUDIT_LOG=C:\mcp\windows_rca_mcp\logs\audit.jsonl
# Fuso das datas nas respostas, em horas em relacao ao UTC (-3 = GMT-3, fixo, sem horario de verao). Padrao -3.
MCP_TZ_OFFSET_HOURS=-3

# ---------------------------------------------------------------------------------------------------------------------
# 6. COMO O MCP E OFERECIDO (so mexa para publicar o MCP em outro servidor)
# ---------------------------------------------------------------------------------------------------------------------
# stdio (padrao) = Claude Code/Desktop na mesma maquina | http = deploy remoto (exige MCP_AUTH_TOKEN)
MCP_TRANSPORT=stdio
# Endereco e porta de escuta no modo http (127.0.0.1 = so a propria maquina).
MCP_HOST=127.0.0.1
MCP_PORT=8000
# OBRIGATORIO no modo http: token Bearer com 32 ou mais caracteres. Gere com:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=
# true permite o modo http SEM token, mas so em loopback (127.0.0.1) e apenas para testes locais.
MCP_ALLOW_INSECURE_LOOPBACK=false
