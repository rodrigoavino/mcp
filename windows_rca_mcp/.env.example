# Copie para .env e preencha. NUNCA versione o .env.
WINRM_USER=DOMINIO\svc_mcp_ops
WINRM_PASSWORD=
WINRM_TRANSPORT=ntlm
WINRM_SSL=true
# Porta: deixe comentado para usar o padrao (5986 com SSL, 5985 sem SSL). So defina para porta nao padrao.
# WINRM_PORT=5986
# validate (producao, exige certificado confiavel) | ignore (somente laboratorio/self-signed)
WINRM_VALIDATE_CERT=validate
# OBRIGATORIA: allowlist de servidores (virgula), aceita curingas. Vazio = nenhum host (fail-closed).
# Use * apenas conscientemente (envia a credencial a qualquer host pedido).
WINRM_ALLOWED_HOSTS=*.dominio.local
# Transporte do MCP: stdio (Claude Code/Desktop) | http (deploy remoto)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# OBRIGATORIO no modo http: token Bearer com >= 32 caracteres (gere com: python -c "import secrets;print(secrets.token_urlsafe(32))")
MCP_AUTH_TOKEN=
# true permite http SEM token, apenas em loopback (testes locais)
MCP_ALLOW_INSECURE_LOOPBACK=false
