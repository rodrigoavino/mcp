# Copie para .env e preencha. NUNCA versione o .env.
WINRM_USER=DOMINIO\svc_mcp_ops
WINRM_PASSWORD=
WINRM_TRANSPORT=ntlm
WINRM_SSL=true
WINRM_PORT=5986
# validate (producao, exige certificado confiavel) | ignore (somente laboratorio/self-signed)
WINRM_VALIDATE_CERT=validate
# allowlist opcional de servidores (virgula). Vazio = qualquer host.
WINRM_ALLOWED_HOSTS=
# Transporte do MCP: stdio (Claude Code/Desktop) | http (deploy remoto)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
