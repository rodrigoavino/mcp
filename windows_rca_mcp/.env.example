# Copie para .env e preencha. NUNCA versione o .env.
WINRM_USER=DOMINIO\svc_mcp_ops
WINRM_PASSWORD=
WINRM_TRANSPORT=ntlm
WINRM_SSL=true
# Porta: deixe comentado para usar o padrao (5986 com SSL, 5985 sem SSL). So defina para porta nao padrao.
# WINRM_PORT=5986
# validate (producao, exige certificado confiavel) | ignore (somente laboratorio/self-signed)
WINRM_VALIDATE_CERT=validate
# OBRIGATORIA: allowlist de servidores (virgula), aceita curingas. Vazio = nenhum host (fail-closed).
# Use * apenas conscientemente (envia a credencial a qualquer host pedido).
WINRM_ALLOWED_HOSTS=*.dominio.local
# Pastas de log ADICIONAIS que get_log_tail/search_log/list_log_files podem ler (separadas por ;). So .log/.txt.
# Padrao: Windows\Logs, System32\LogFiles, Panther, INF, debug e inetpub\logs. Exemplo: WINRM_LOG_DIRS_EXTRA=D:\AppLogs
# WINRM_LOG_DIRS_EXTRA=
# Pastas que read_file/list_directory/find_files/file_info/compare_files NUNCA leem (separadas por ;), alem dos bloqueios
# padrao (hives do registro, NTDS, DPAPI, chaves SSH, certificados/chaves, dumps). Exemplo: WINRM_FILE_DENY_EXTRA=D:\Segredos
# WINRM_FILE_DENY_EXTRA=
# Transporte do MCP: stdio (Claude Code/Desktop) | http (deploy remoto)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# OBRIGATORIO no modo http: token Bearer com >= 32 caracteres (gere com: python -c "import secrets;print(secrets.token_urlsafe(32))")
MCP_AUTH_TOKEN=
# true permite http SEM token, apenas em loopback (testes locais)
MCP_ALLOW_INSECURE_LOOPBACK=false
# Auditoria das chamadas (tool, host, resultado; sem conteudo nem segredos). off desliga
MCP_AUDIT=on
# MCP_AUDIT_LOG=C:\mcp\windows_rca_mcp\logs\audit.jsonl
